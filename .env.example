# EchoTrace AI - Environment Configuration Example
# Copy this file to .env and fill in your actual values before running the application.

# Application Environment
APP_ENV=development
DEBUG=true

# Database Connection (SQLite default)
DATABASE_URL=sqlite:///./echotrace.db

# Frontend CORS Origin
CORS_ORIGINS=http://localhost:5173

# Groq Cloud AI API Key (Optional: for ultra-fast live LLM inference)
# Get your API key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
